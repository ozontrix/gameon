{
  "framework": "nextjs",
  "buildCommand": "next build",
  "devCommand": "next dev",
  "outputDirectory": ".next",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/clear-expired",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/booking-reminders",
      "schedule": "30 1 * * *"
    }
  ]
}
